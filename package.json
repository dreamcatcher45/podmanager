    "configuration": {
      "title": "Podmanager",
      "properties": {
        "podmanager.podmanPath": {
          "type": "string",
          "default": "podman",
          "scope": "machine",
          "description": "Path or command used to run podman, e.g. 'podman', '/usr/bin/podman', 'flatpak-spawn --host podman' or 'podman --remote'. Quote paths that contain spaces. Can only be set in user (or remote machine) settings, not in a workspace's .vscode/settings.json."
        },
        "podmanager.composePath": {
          "type": "string",
          "default": "podman-compose",
          "scope": "machine",
          "description": "Custom path to the compose executable (e.g., 'podman-compose' or 'docker-compose.exe'). May include leading arguments, e.g. 'docker compose'; quote paths that contain spaces. Never run through a shell. Can only be set in user (or remote machine) settings, not in a workspace's .vscode/settings.json."
        },
        "podmanager.composeCommandStyle": {
          "type": "string",
          "default": "default",
          "enum": [
            "default",
            "podman-compose",
            "podman-space-compose"
          ],
          "description": "Style of compose command execution: 'default' uses podman-compose, 'podman-compose' uses the separate executable, 'podman-space-compose' adds space between podman and compose"
        },
        "podmanager.enablePushCommand": {
          "type": "boolean",
          "default": false,
          "description": "Show the Push Image action on images. Off by default."
        },
        "podmanager.pushDefaultRegistry": {
          "type": "string",
          "default": "",
          "description": "Default registry (and namespace) used to pre-fill the destination of Push Image, e.g. 'quay.io/username' or 'docker.io/username'. Leave empty to push to the image's own reference."
        },
        "podmanager.machineName": {
          "type": "string",
          "default": "podman-machine-default",
          "scope": "machine",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "patternErrorMessage": "Machine names may contain only letters, digits, '_', '.' and '-', and must not start with '-'.",
          "description": "Name of the Podman machine to connect to. Can only be set in user (or remote machine) settings, not in a workspace's .vscode/settings.json."
        },
        "podmanager.confirmDeletions": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before deleting resources (pods, images, containers, volumes, networks). Uncheck to skip confirmation."
        },
        "podmanager.logsOutput": {
          "type": "string",
          "default": "outputChannel",
          "enum": [
            "outputChannel",
            "terminal"
          ],
          "description": "Choose where container logs are shown: 'outputChannel' uses the Output panel, 'terminal' opens a new terminal. Default: outputChannel."
        },
        "podmanager.autoRefreshInterval": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Automatically refresh the Podman view every N seconds while it is visible. 0 (the default) turns auto-refresh off. When enabled the minimum interval is 5 seconds."
        },
        "podmanager.showWhatsNew": {
          "type": "boolean",
          "default": true,
          "description": "Open the What's New page once after Pod Manager is installed or updated to a release that has important notes. You can always open it with the \"Show What's New\" command."
        }
      }
    }
